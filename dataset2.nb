       Hold[$CellContext`a$$], 0}, -3, 0.5}}, Typeset`size$$ = {
    359.6428872256399, {214., 218.}}, Typeset`update$$ = 0, 
    Typeset`initDone$$, Typeset`skipInitDone$$ = True}, 
    DynamicBox[Manipulate`ManipulateBoxes[
     1, StandardForm, 
      "Variables" :> {$CellContext`a$$ = 0, $CellContext`\[Alpha]$$ = 
        0.4, $CellContext`\[Beta]$$ = 0.2}, "ControllerVariables" :> {}, 
      "OtherVariables" :> {
       Typeset`show$$, Typeset`bookmarkList$$, Typeset`bookmarkMode$$, 
        Typeset`animator$$, Typeset`animvar$$, Typeset`name$$, 
        Typeset`specs$$, Typeset`size$$, Typeset`update$$, Typeset`initDone$$,
         Typeset`skipInitDone$$}, "Body" :> 
      Module[{$CellContext`b$, $CellContext`pts$, $CellContext`arcLen$, \
$CellContext`arrowPositions$, $CellContext`arrows$, $CellContext`nArrows$ = 
         10, $CellContext`n$ = 
         200, $CellContext`dt$, $CellContext`f$}, $CellContext`b$[
           Pattern[$CellContext`t$, 
            Blank[]]] := 
         Exp[I $CellContext`t$] (1 - 
             Exp[(-I) $CellContext`t$])^$CellContext`\[Alpha]$$ + \
$CellContext`a$$ 
           Exp[I $CellContext`t$] (1 - 
             Exp[(-I) $CellContext`t$])^$CellContext`\[Beta]$$ + 
          1; $CellContext`dt$ = (2 Pi)/$CellContext`n$; $CellContext`f$[
           Pattern[$CellContext`i$, 
            Blank[]]] := ParametricPlot[{
            Re[
             $CellContext`b$[$CellContext`t]], 
            Im[
             $CellContext`b$[$CellContext`t]]}, {$CellContext`t, \
$CellContext`i$ $CellContext`dt$, ($CellContext`i$ + 1) $CellContext`dt$}, 
           PlotStyle -> {Thick, Blue}]; $CellContext`pts$ = Table[{
            Re[
             $CellContext`b$[$CellContext`t]], 
            Im[
             $CellContext`b$[$CellContext`t]]}, {$CellContext`t, 0, 2 Pi, 
            0.01}]; $CellContext`arcLen$ = Accumulate[
           Prepend[
            MapApply[EuclideanDistance, 
             Partition[$CellContext`pts$, 2, 1]], 
            0]]; $CellContext`arrowPositions$ = Table[
           First[
            FirstPosition[$CellContext`arcLen$, 
             PatternTest[
              Blank[], # >= $CellContext`k& ]]], {$CellContext`k, 
            Part[$CellContext`arcLen$, -1]/$CellContext`nArrows$, 
            Part[$CellContext`arcLen$, -1] (($CellContext`nArrows$ - 
              1)/$CellContext`nArrows$), 
            Part[$CellContext`arcLen$, -1]/$CellContext`nArrows$}]; \
$CellContext`arrows$ = Table[{
            Arrowheads[0.02], 
            Arrow[
             Part[$CellContext`pts$, 
              
              Span[$CellContext`i, $CellContext`i + 
               1]]]}, {$CellContext`i, $CellContext`arrowPositions$}]; Show[
          Table[
           $CellContext`f$[$CellContext`j], {$CellContext`j, 
            0, $CellContext`n$ - 1}], 
          Graphics[{Black, Thick, $CellContext`arrows$}], Epilog -> {
            Text[
             Style["S", Bold, 26], {0.68, 0.2}]}, LabelStyle -> 
          Directive[Black], AxesLabel -> {
            Style["Re(b)", Black, 10], 
            Style["Im(b)", Black, 10]}, Ticks -> Automatic, AxesStyle -> 
          Directive[Black], AxesOrigin -> {0, 0}, PlotRange -> All, PlotStyle -> 
          Blue]], "Specifications" :> {{{$CellContext`\[Alpha]$$, 0.4}, 0, 
