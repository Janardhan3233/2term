Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "xVals", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Alpha]", "=", "0.8"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Beta]", "=", "0.2"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"a", "=", "0.6"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"b", "=", 
   RowBox[{"-", "1.5"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"x", "[", "0", "]"}], "=", "0.1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"nmax", "=", "1000"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"omega", "[", 
    RowBox[{"mu_", ",", "k_Integer"}], "]"}], ":=", 
   RowBox[{"Which", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"mu", "==", "1"}], "&&", 
      RowBox[{"k", "==", "1"}]}], ",", "1", ",", 
     RowBox[{
      RowBox[{"mu", "==", "1"}], "&&", 
      RowBox[{"k", ">=", "2"}]}], ",", "0", ",", "True", ",", 
     FractionBox[
      RowBox[{"Gamma", "[", 
       RowBox[{"k", "-", "mu"}], "]"}], 
      RowBox[{
       RowBox[{"Gamma", "[", 
        RowBox[{"1", "-", "mu"}], "]"}], " ", 
       RowBox[{"Gamma", "[", "k", "]"}]}]]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"x", "[", "1", "]"}], "=", 
   RowBox[{
    FractionBox[
     RowBox[{"a", "+", "b"}], 
     RowBox[{"a", "+", "1"}]], " ", 
    RowBox[{"x", "[", "0", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"x", "[", "n", "]"}], "=", 
      RowBox[{
       RowBox[{
        FractionBox[
         RowBox[{"a", "+", "b"}], 
         RowBox[{"a", "+", "1"}]], " ", 
        RowBox[{"x", "[", 
         RowBox[{"n", "-", "1"}], "]"}]}], "-", 
       RowBox[{
        FractionBox["1", 
         RowBox[{"a", "+", "1"}]], "*", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"omega", "[", 
              RowBox[{"\[Alpha]", ",", 
               RowBox[{"n", "-", "s"}]}], "]"}], "+", 
             RowBox[{"a", "*", 
              RowBox[{"omega", "[", 
               RowBox[{"\[Beta]", ",", 
                RowBox[{"n", "-", "s"}]}], "]"}]}]}], ")"}], "*", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"x", "[", 
              RowBox[{"s", "+", "1"}], "]"}], "-", 
             RowBox[{"x", "[", "s", "]"}]}], ")"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"s", ",", "0", ",", 
            RowBox[{"n", "-", "2"}]}], "}"}]}], "]"}]}]}]}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "2", ",", "nmax"}], "}"}]}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"xVals", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"j", ",", 
        RowBox[{"x", "[", "j", "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "0", ",", "nmax"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"j", ",", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{"x", "[", "j", "]"}], ",", "16"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "0", ",", "10"}], "}"}]}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{"xVals", ",", 
   RowBox[{"PlotStyle", "->", "Blue"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Style", "[", 
       RowBox[{"\"\<n\>\"", ",", "Black", ",", "20"}], "]"}], ",", 
      RowBox[{"Style", "[", 
       RowBox[{"\"\<x(n)\>\"", ",", "Black", ",", "20"}], "]"}]}], "}"}]}], 
   ",", 
   RowBox[{"LabelStyle", "->", 
    RowBox[{"Directive", "[", "Black", "]"}]}], ",", 
   RowBox[{"FrameStyle", "->", "Black"}], ",", 
   RowBox[{"Ticks", "->", "Automatic"}], ",", 
   RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], "Input",
