Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "b", ",", "pts", ",", "arcLen", ",", "arrowPositions", ",", "arrows", 
       ",", 
       RowBox[{"nArrows", "=", "10"}], ",", 
       RowBox[{"n", "=", "200"}], ",", "dt", ",", "f"}], "}"}], ",", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"Parametric", " ", "curve"}], "-", "UNCHANGED"}], "*)"}], 
     RowBox[{
      RowBox[{
       RowBox[{"b", "[", "t_", "]"}], ":=", 
       RowBox[{
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{"I", "*", "t"}], "]"}], " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", 
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{"-", "I"}], "*", "t"}], "]"}]}], ")"}], "^", 
          "\[Alpha]"}]}], "+", 
        RowBox[{"a", " ", 
         RowBox[{"Exp", "[", 
          RowBox[{"I", "*", "t"}], "]"}], " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", 
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{"-", "I"}], "*", "t"}], "]"}]}], ")"}], "^", 
          "\[Beta]"}]}], "+", "1"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
         RowBox[{"Split", " ", "t", " ", "range", " ", "0"}], ".."}], "2", 
        "Pi", " ", "into", " ", "n", " ", "subintervals"}], "*)"}], 
      RowBox[{"dt", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"2", " ", "Pi"}], ")"}], "/", "n"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"f", "[", "i_", "]"}], ":=", 
       RowBox[{"ParametricPlot", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Re", "[", 
            RowBox[{"b", "[", "t", "]"}], "]"}], ",", 
           RowBox[{"Im", "[", 
            RowBox[{"b", "[", "t", "]"}], "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", 
           RowBox[{"i", "*", "dt"}], ",", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"i", "+", "1"}], ")"}], "*", "dt"}]}], "}"}], ",", 
         RowBox[{"PlotStyle", "->", 
          RowBox[{"{", 
           RowBox[{"Thick", ",", "Blue"}], "}"}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Sample", " ", "points", " ", "for", " ", "arc", " ", "length", " ", 
        "computation"}], "*)"}], 
      RowBox[{"pts", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Re", "[", 
            RowBox[{"b", "[", "t", "]"}], "]"}], ",", 
           RowBox[{"Im", "[", 
            RowBox[{"b", "[", "t", "]"}], "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", 
           RowBox[{"2", " ", "Pi"}], ",", "0.01"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Cumulative", " ", "arc", " ", "length"}], "*)"}], 
      RowBox[{"arcLen", "=", 
       RowBox[{"Accumulate", "[", 
        RowBox[{"Prepend", "[", 
         RowBox[{
          RowBox[{"EuclideanDistance", "@@@", 
           RowBox[{"Partition", "[", 
            RowBox[{"pts", ",", "2", ",", "1"}], "]"}]}], ",", "0"}], "]"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Arrow", " ", "positions", " ", "equally", " ", "spaced", " ", "in", 
        " ", "arc", " ", "length"}], "*)"}], 
      RowBox[{"arrowPositions", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"First", "@", 
          RowBox[{"FirstPosition", "[", 
           RowBox[{"arcLen", ",", 
            RowBox[{"_", "?", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"#", ">=", "k"}], "&"}], ")"}]}]}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", 
           RowBox[{
            RowBox[{"arcLen", "[", 
             RowBox[{"[", 
              RowBox[{"-", "1"}], "]"}], "]"}], "/", "nArrows"}], ",", 
           RowBox[{
            RowBox[{"arcLen", "[", 
             RowBox[{"[", 
              RowBox[{"-", "1"}], "]"}], "]"}], "*", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"nArrows", "-", "1"}], ")"}], "/", "nArrows"}]}], ",", 
           RowBox[{
            RowBox[{"arcLen", "[", 
             RowBox[{"[", 
              RowBox[{"-", "1"}], "]"}], "]"}], "/", "nArrows"}]}], "}"}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Arrows", " ", "along", " ", "curve"}], "*)"}], 
      RowBox[{"arrows", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Arrowheads", "[", "0.02", "]"}], ",", 
           RowBox[{"Arrow", "[", 
            RowBox[{"pts", "[", 
             RowBox[{"[", 
              RowBox[{"i", ";;", 
               RowBox[{"i", "+", "1"}]}], "]"}], "]"}], "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "arrowPositions"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Combine", " ", "the", " ", "n", " ", "piecewise", " ", "plots"}], 
       "*)"}], 
      RowBox[{"Show", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"f", "[", "j", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "0", ",", 
            RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}], ",", 
        RowBox[{"Graphics", "[", 
         RowBox[{"{", 
          RowBox[{"Black", ",", "Thick", ",", "arrows"}], "}"}], "]"}], ",", 
        RowBox[{"Epilog", "->", 
         RowBox[{"{", 
          RowBox[{"Text", "[", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{"\"\<S\>\"", ",", "Bold", ",", "26"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"0.68", ",", "0.2"}], "}"}]}], "]"}], "}"}]}], ",", 
        RowBox[{"LabelStyle", "->", 
         RowBox[{"Directive", "[", "Black", "]"}]}], ",", 
        RowBox[{"AxesLabel", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Style", "[", 
            RowBox[{"\"\<Re(b)\>\"", ",", "Black", ",", "10"}], "]"}], ",", 
           RowBox[{"Style", "[", 
            RowBox[{"\"\<Im(b)\>\"", ",", "Black", ",", "10"}], "]"}]}], 
          "}"}]}], ",", 
        RowBox[{"Ticks", "->", "Automatic"}], ",", 
        RowBox[{"AxesStyle", "->", 
         RowBox[{"Directive", "[", "Black", "]"}]}], ",", 
        RowBox[{"(*", 
         RowBox[{
         "Put", " ", "both", " ", "coordinate", " ", "axes", " ", "at", " ", 
          "zero"}], "*)"}], 
        RowBox[{"AxesOrigin", "->", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0"}], "}"}]}], ",", 
        RowBox[{"PlotRange", "->", "All"}], ",", 
        RowBox[{"PlotStyle", "->", "Blue"}]}], "]"}]}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Alpha]", ",", "0.4"}], "}"}], ",", "0", ",", "1"}], "}"}], 
   ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Beta]", ",", "0.2"}], "}"}], ",", "0", ",", "1"}], "}"}], 
   ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a", ",", "0"}], "}"}], ",", 
     RowBox[{"-", "3"}], ",", "0.5"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9996541841108303`*^9, 3.9996541841108303`*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"bd92b888-624e-4c04-afa4-b6912ba30148"],

Cell[BoxData[
 TagBox[
  StyleBox[
   DynamicModuleBox[{$CellContext`a$$ = 0, $CellContext`\[Alpha]$$ = 
    0.4, $CellContext`\[Beta]$$ = 0.2, Typeset`show$$ = True, 
    Typeset`bookmarkList$$ = {}, Typeset`bookmarkMode$$ = "Menu", 
    Typeset`animator$$, Typeset`animvar$$ = 1, Typeset`name$$ = 
